# Public HTTPS destinations, not credentials. No query strings or private links.
# Configure after setting up your store, payment provider and lab.
PRINT_STORE_URL=
# Public Cloudflare delivery Worker URL only. Never include an access code.
CLIENT_DELIVERY_URL=
# These pages are statically built; rebuild/redeploy after changing these values.

# Custom Stripe + Prodigi checkout (no Pixieset required).
# Leave disabled until sandbox tests, real product pricing, lab sample and policies are complete.
SITE_URL=
PRINT_CHECKOUT_ENABLED=false
PRINT_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRODIGI_API_KEY=
PRINT_TERMS_URL=
# Server-only JSON array. See docs/COMMERCE.md. Prices are integer CAD cents.
PRINT_PRODUCTS_JSON=[]

# Optional owner workspace configuration (single persistent Node server).
# Otherwise a random key is generated in .studio/owner-key.txt.
STUDIO_PASSWORD=
# Absolute PRIVATE persistent directory, never inside public/.
# STUDIO_DATA_DIR=/private/path/studio-records

# Optional direct invoice/agreement email. Use a provider-issued SMTP/app credential.
# Never put these credentials in public settings or Git.
STUDIO_SMTP_HOST=
STUDIO_SMTP_PORT=587
STUDIO_SMTP_USER=
STUDIO_SMTP_PASSWORD=
STUDIO_MAIL_FROM=
